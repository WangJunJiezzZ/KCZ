<?xml version="1.0" encoding="utf-8"?>
<!-- 二次开发：奈飞风格首页（左侧导航 + 顶部大图 + 横向海报行） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <!-- ===== 顶部大图区 ===== -->
    <!-- 二次开发：大图区（剧照在右上角，其余是黑底） -->
    <FrameLayout
        android:id="@+id/billboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 二次开发：剧照只占右上角一块 16:9 区域（宽度为屏幕 85%，Billboard 里按屏幕算尺寸），
             左边和底部渐隐到黑色；卡片行底下是黑底，卡片不再压在剧照上 -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="672dp"
            android:layout_height="378dp"
            android:layout_gravity="end|top">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/stageFadeLeft"
                android:layout_width="336dp"
                android:layout_height="match_parent"
                android:background="@drawable/stage_fade_left" />

            <View
                android:id="@+id/stageFadeBottom"
                android:layout_width="match_parent"
                android:layout_height="208dp"
                android:layout_gravity="bottom"
                android:background="@drawable/stage_fade_bottom" />
        </FrameLayout>

        <!-- 二次开发：查不到横版剧照时，右侧显示清晰的竖版海报卡片（背景则是同一张海报模糊压暗），不把小海报放大铺满 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/keyart"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="140dp"
            android:elevation="12dp"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:shapeAppearanceOverlay="@style/HomeCardShape" />

        <!-- 顶部轻微压暗：保证右上角时钟、源名称清楚 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/home_scrim_top" />

        <!-- 文字信息 -->
        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="96dp"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <!-- 二次开发：去掉左上角「看锤子」字样；上边距补上它原来占的高度，下面的片名位置不变 -->
            <TextView
                android:id="@+id/kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp"
                android:letterSpacing="0.08"
                android:textColor="@color/home_text_dim"
                android:textSize="12sp"
                tools:text="今日推荐" />

            <TextView
                android:id="@+id/billTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowRadius="12"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="钢铁之泪" />

            <TextView
                android:id="@+id/billMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:singleLine="true"
                android:textColor="#E5E5E5"
                android:textSize="13sp"
                tools:text="2012 · 科幻 · 更新至 12 集" />

            <TextView
                android:id="@+id/billDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="2"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                tools:text="简介" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== 右上角：当前首页源（按菜单键或点击可切换）+ 时钟 ===== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp" />

        <com.fongmi.android.tv.ui.custom.CustomTitleView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:ellipsize="marquee"
            android:focusable="false"
            android:maxWidth="260dp"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/home_text_dim"
            android:textSize="13sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="09:20" />
    </LinearLayout>

    <!-- ===== 内容行 ===== -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="80dp"
        android:layout_marginTop="236dp">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="32dp"
            android:paddingBottom="40dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- ===== 左侧导航（放在最后，保证盖在内容上面） ===== -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="@drawable/home_rail_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</FrameLayout>
