<?xml version="1.0" encoding="utf-8"?>
<!-- 二次开发：奈飞风格片库（左侧导航 + 顶部文字分类 + 大图区 + 按筛选拆成的横版卡片行） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <!-- ===== 大图区（和首页同一套：全屏剧照 + 左侧 / 底部渐隐） ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 二次开发：剧照只占右上角一块 16:9 区域（宽度为屏幕 85%，Billboard 里按屏幕算尺寸），
             左边和底部渐隐到黑色；卡片行底下是黑底，卡片不再压在剧照上 -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="672dp"
            android:layout_height="378dp"
            android:layout_gravity="end|top">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/stageFadeLeft"
                android:layout_width="336dp"
                android:layout_height="match_parent"
                android:background="@drawable/stage_fade_left" />

            <View
                android:id="@+id/stageFadeBottom"
                android:layout_width="match_parent"
                android:layout_height="208dp"
                android:layout_gravity="bottom"
                android:background="@drawable/stage_fade_bottom" />
        </FrameLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/keyart"
            android:layout_width="104dp"
            android:layout_height="156dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="140dp"
            android:elevation="12dp"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:shapeAppearanceOverlay="@style/HomeCardShape" />

        <!-- 顶部压暗稍深：分类标签压在剧照上也看得清 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/home_scrim_top" />

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="96dp"
            android:layout_marginTop="76dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/billTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowRadius="12"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="流浪地球 3" />

            <TextView
                android:id="@+id/billMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:textColor="#E5E5E5"
                android:textSize="13sp"
                tools:text="2026  ·  大陆  ·  科幻" />

            <TextView
                android:id="@+id/billDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="2"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                tools:text="简介" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== 顶部：分类标签 + 时钟（点分类在下面展开筛选） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/tabs"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="09:20" />
    </LinearLayout>

    <!-- ===== 内容行 ===== -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="80dp"
        android:layout_marginTop="236dp">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="32dp"
            android:paddingBottom="40dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- ===== 筛选区：点顶部分类（或按菜单键）在分类下面展开，一行一个筛选条件；条件多时上下滚动 ===== -->
    <ScrollView
        android:id="@+id/filterArea"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/filterRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <!-- ===== 左侧导航（和首页一样，放在最后盖在内容上面） ===== -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="@drawable/home_rail_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</FrameLayout>
