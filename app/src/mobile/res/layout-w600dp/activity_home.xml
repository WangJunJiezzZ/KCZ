<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/mobile_background">
    <com.google.android.material.navigationrail.NavigationRailView android:id="@+id/navigation" tools:viewBindingType="com.google.android.material.navigation.NavigationBarView"
        android:layout_width="88dp" android:layout_height="match_parent" android:layout_alignParentStart="true"
        android:background="@color/mobile_surface" app:menu="@menu/menu_nav" app:menuGravity="center"
        app:itemIconTint="@color/selector_nav" app:itemTextColor="@color/selector_nav"
        app:itemActiveIndicatorStyle="@style/MobileNavIndicator" app:labelVisibilityMode="labeled" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/container" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_toEndOf="@id/navigation" />
</RelativeLayout>