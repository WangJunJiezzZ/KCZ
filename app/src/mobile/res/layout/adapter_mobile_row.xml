 </LinearLayout>
 <com.fongmi.android.tv.ui.custom.MobileShelfView android:id="@+id/cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingStart="8dp" android:paddingEnd="8dp" android:nestedScrollingEnabled="false" />
