<?xml version="1.0" encoding="utf-8"?>
<!-- 二次开发：参考 B 站 / 奈飞重排播放设置：倍速改固定档位、去掉 EXO 与硬解/软解、分区更少更清楚 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    tools:background="@color/white">

    <com.google.android.material.textview.MaterialTextView
        style="@style/ControlSection"
        android:layout_marginTop="12dp"
        android:text="@string/control_section_speed" />

    <LinearLayout
        android:id="@+id/speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <com.google.android.material.textview.MaterialTextView
        style="@style/ControlSection"
        android:text="@string/control_section_scale" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale_0"
                style="@style/ControlChip"
                android:tag="0"
                tools:text="原始" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale_1"
                style="@style/ControlChip"
                android:tag="1"
                tools:text="16:9" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale_2"
                style="@style/ControlChip"
                android:tag="2"
                tools:text="4:3" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale_3"
                style="@style/ControlChip"
                android:tag="3"
                tools:text="填充" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale_4"
                style="@style/ControlChip"
                android:tag="4"
                tools:text="裁剪" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </HorizontalScrollView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/parseText"
        style="@style/ControlSection"
        android:text="@string/parse"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/parse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="5"
        tools:listitem="@layout/adapter_parse"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track"
        style="@style/ControlSection"
        android:text="@string/control_section_track"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text"
            style="@style/ControlChip"
            android:tag="3"
            android:text="@string/play_track_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/audio"
            style="@style/ControlChip"
            android:tag="1"
            android:text="@string/play_track_audio"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/video"
            style="@style/ControlChip"
            android:tag="2"
            android:text="@string/play_track_video"
            android:visibility="gone" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.textview.MaterialTextView
        style="@style/ControlSection"
        android:text="@string/control_section_more" />

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="wrap">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/danmaku"
            style="@style/ControlChip.Wrap"
            android:text="@string/control_danmaku_setting"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/opening"
            style="@style/ControlChip.Wrap"
            tools:text="片头" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ending"
            style="@style/ControlChip.Wrap"
            tools:text="片尾" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/repeat"
            style="@style/ControlChip.Wrap"
            android:text="@string/control_repeat" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timer"
            style="@style/ControlChip.Wrap"
            android:text="@string/control_timer" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/edition"
            style="@style/ControlChip.Wrap"
            android:text="@string/play_edition"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chapter"
            style="@style/ControlChip.Wrap"
            android:text="@string/play_chapter"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.flexbox.FlexboxLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
