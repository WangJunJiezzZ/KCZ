<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/mobile_background</item>
        <item name="android:colorBackground">@color/mobile_background</item>
        <item name="colorSurface">@color/mobile_surface</item>
        <item name="colorSurfaceContainer">@color/mobile_surface</item>
        <item name="colorPrimary">@color/mobile_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/mobile_red</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/mobile_red</item>
        <item name="colorSecondaryContainer">@color/mobile_surface</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="Theme.Bridge" parent="Theme.Base">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
